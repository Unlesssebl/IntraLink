# ==============================================================================
# IntraLink — Единая конфигурация окружения (Single Source of Truth)
# Скопируйте данный файл в .env и заполните своими значениями: cp .env.example .env
# ==============================================================================

# Базовый URL IntraService (обязательно со слэшем на конце)
INTRASERVICE_URL=https://intraservice.example.com/api/

# Часовой пояс IntraService
INTRASERVICE_TZ=Europe/Moscow

# Лимит одновременных подключений к IntraService
MAX_CONCURRENT_REQUESTS=10

# Интервал опроса IntraService воркером (в секундах)
POLLING_INTERVAL=30

# ПРИМЕЧАНИЕ: Учетные данные сервисного аккаунта IntraService и доменные доступы (AD/WinRM)
# не хранятся в открытом виде в .env! Они безопасно настраиваются через единый центр управления
# Web UI /admin (Credentials Vault), шифруются алгоритмом Fernet в PostgreSQL (system_settings)
# и автоматически прогреваются в изолированном кэше Redis при старте сервисов.

# Порты локальных сервисов
CORE_API_PORT=8000
REDIS_PORT=6379
POSTGRES_PORT=5432
OLLAMA_PORT=11435

# База данных PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intraservice

# Брокер событий и кэш Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Pre-shared ключ для доступа telegram-bot и CLI к Core API Gateway
APP_ENV=development
BOT_API_KEY=change-this-bot-api-key
WORKER_API_KEY=change-this-worker-api-key
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Список корпоративных логинов IntraService через запятую с правами администратора /admin
ADMIN_LOGINS=belikov.a,your_admin_login

# Токен Telegram-бота (aiogram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ------------------------------------------------------------------------------
# Искусственный Интеллект и Шлюз LiteLLM (AI Hub)
# ------------------------------------------------------------------------------
# Шлюз LiteLLM Proxy с ротацией ключей и балансировкой
LITELLM_API_KEY=change-this-litellm-api-key
LITELLM_BASE_URL=http://localhost:4000/v1
GEMINI_MODEL=intralink-chat
EMBEDDING_MODEL=bge-m3

# Ключи Google Gemini API для пула ротации в LiteLLM Proxy
GEMINI_API_KEY=your_gemini_api_key_1

# Локальная нейросеть Ollama (Закрытый RED контур)
# Выбор конфигурации Ollama для Docker Compose:
# 1) Хостовая Ollama (Windows / GPU на хосте — БЕЗ контейнера Ollama, прямое подключение без оверхеда):
# COMPOSE_FILE=docker-compose.yml
# 2) Контейнерная Ollama на CPU:
# COMPOSE_FILE=docker-compose.yml:docker-compose.ollama-cpu.yml
# 3) Контейнерная Ollama с NVIDIA GPU (CUDA / RTX 3050):
# COMPOSE_FILE=docker-compose.yml:docker-compose.ollama-nvidia.yml
# 4) Контейнерная Ollama с AMD GPU (Vulkan):
# COMPOSE_FILE=docker-compose.yml:docker-compose.ollama-vulkan.yml

# Индекс видеокарты NVIDIA (1 для RTX 3050 при наличии GTX 1650 на 0)
CUDA_VISIBLE_DEVICES=1

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_TIMEOUT=30.0
OLLAMA_NUM_PARALLEL=2
