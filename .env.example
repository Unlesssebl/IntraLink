BOT_TOKEN=your_telegram_bot_token_here
INTRAService_URL=https://your-domain.intraservice.ru/api/
POLLING_INTERVAL=60

# Настройки для Docker и обхода VPN (опционально)
# Путь к базе данных (в Docker используется /app/data/intrabot.db)
DB_PATH=intrabot.db

# Адреса прокси-серверов в формате http://[user:pass@]host:port
# Для Docker на Windows, чтобы использовать прокси на хосте, используйте host.docker.internal
# TELEGRAM_PROXY=http://host.docker.internal:1080
# INTRAService_PROXY=http://host.docker.internal:1080
