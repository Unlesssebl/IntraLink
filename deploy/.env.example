# ==============================================================================
# IntraLink v2 — Единая конфигурация окружения (Single Source of Truth)
# Скопируйте этот файл в корень проекта или deploy/: cp deploy/.env.example .env
# ==============================================================================

# Порты локальных сервисов
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# База данных PostgreSQL (pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intraservice

# Брокер сообщений и кэш Redis
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Искусственный Интеллект и Шлюз LiteLLM (AI Gateway)
# ------------------------------------------------------------------------------
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-intralink-dev

# Облачные провайдеры (Free Tier / ротация ключей)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
DEEPSEEK_API_KEY=

# Локальная нейросеть Ollama (для хостового инференса)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# Интеграция с IntraService API
# ВНИМАНИЕ (GEMINI.md): URL оканчивается на /api. Не дублировать /api в коде!
# ------------------------------------------------------------------------------
INTRASERVICE_URL=https://servicedesk-pub.corporate.loc/api
INTRASERVICE_TZ=Europe/Moscow
INTRASERVICE_LOGIN=
INTRASERVICE_PASSWORD=

# ------------------------------------------------------------------------------
# Безопасность и CORS
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=change-this-jwt-secret-in-production
ENCRYPTION_KEY=
