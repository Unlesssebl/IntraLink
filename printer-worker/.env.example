CORE_API_URL=http://core-api:8000/api/v1
BOT_API_KEY=test_api_key_12345
REDIS_URL=redis://redis:6379/0

# Учетные данные WinRM на удаленных ПК пользователей
WINRM_USERNAME=administrator@domain.loc
WINRM_PASSWORD=strong_password_here
WINRM_TRANSPORT=ntlm

# Настройки LLM для извлечения параметров
LLM_PROVIDER=ollama
LLM_API_URL=http://ollama:11434
LLM_API_KEY=
LLM_MODEL_NAME=llama3

# Локальные настройки принтеров
PRINTERS_KB_PATH=knowledge_base/printers_knowledge_base.json
PRINT_OUTPUT_DIR=./prints
MAX_CONCURRENT_JOBS=5

# ID вашего аккаунта в IntraService (IS user ID).
# Воркер будет обрабатывать только заявки, где вы назначены исполнителем.
# Узнать можно в профиле IntraService или через GET /api/user/self.
# Если оставить пустым — фильтр не применяется.
PRINTER_EXECUTOR_IS_USER_ID=
