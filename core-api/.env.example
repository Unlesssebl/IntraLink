# URL-адрес API IntraService (например, https://demo.intraservice.ru/api/)
INTRASERVICE_URL=https://your-domain.intraservice.ru/api/

# Строка подключения к базе данных (PostgreSQL по умолчанию)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intraservice
# Для SQLite раскомментируйте ниже:
# DATABASE_URL=sqlite+aiosqlite:///./core_api.db

# API-ключ для авторизации запросов бота к Core API (сгенерируйте надежный секрет)
BOT_API_KEY=your_super_secret_api_key_here

# Проверка SSL сертификатов (True/False). Установите False для самоподписанных сертификатов.
SSL_VERIFY=False
