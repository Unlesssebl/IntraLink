# URL-адрес API IntraService (например, https://demo.intraservice.ru/api/)
INTRASERVICE_URL=https://your-domain.intraservice.ru/api/

# Строка подключения к базе данных (PostgreSQL по умолчанию)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intraservice
# Для SQLite раскомментируйте ниже:
# DATABASE_URL=sqlite+aiosqlite:///./core_api.db

# API-ключ для авторизации запросов бота к Core API (сгенерируйте надежный секрет)
BOT_API_KEY=your_super_secret_api_key_here

# Проверка SSL сертификатов (True/False). Установите False для самоподписанных сертификатов.
SSL_VERIFY=False

# URL-адрес для подключения к Redis
REDIS_URL=redis://localhost:6379/0

# Ключ шифрования для токенов. Сгенерируйте командой:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Логин выделенного сервисного аккаунта IntraService.
# Цель: Оптимизация производительности и отказоустойчивость. Воркер выполняет единый 
# глобальный опрос API от лица этого аккаунта (вместо сотен запросов от каждого отдельного 
# пользователя), что кардинально снижает сетевую нагрузку и устраняет зависимость от 
# активных сессий пользователей в боте.
# Нужен как при запуске в Docker, так и вне его (не является секретом, передается в открытом виде).
INTRASERVICE_SERVICE_LOGIN=intratest

# ВНИМАНИЕ: При запуске в Docker пароли и секреты считываются из Docker Secrets
# по путям, указанным в docker-compose.yml. Файлы секретов создаются в каталоге `/.secrets/`.
# Нижеприведенные переменные нужны ТОЛЬКО для локального запуска вне Docker (например, python app/main.py):

# Пароль сервисного аккаунта (для локального запуска вне Docker)
# INTRASERVICE_SERVICE_PASSWORD=ваш_пароль

# Секретный ключ JWT для веб-панели (для локального запуска вне Docker)
# JWT_SECRET=ваш_секрет_jwt
